{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/chat/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/speech/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/music/route.ts": {
      "maxDuration": 15
    }
  }
}
